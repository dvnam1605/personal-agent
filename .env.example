# Application Environment
ENVIRONMENT=development
DEBUG=true

# HTTP boundary security
# Shared API key required on every request via X-API-Key.
# Unset outside development/testing fails closed (all authenticated routes reject).
SECURITY__API_KEY=
# Explicit CORS origin allowlist (never combine '*' with credentials).
SECURITY__CORS_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Database (PostgreSQL with pgvector mapped to port 5434)
DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5434/assistant
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__ECHO=false

# Redis Cache & Sessions
REDIS__URL=redis://localhost:6379/0
REDIS__SESSION_TTL_SECONDS=86400
REDIS__CACHE_TTL_SECONDS=3600
REDIS__SOCKET_TIMEOUT_SECONDS=2.0

# LangSmith Tracing (Optional)
LANGSMITH__TRACING_ENABLED=false
LANGSMITH__ENDPOINT=https://api.smith.langchain.com
LANGSMITH__API_KEY=
LANGSMITH__PROJECT=personal-ai-assistant

# LLM Providers (Configure when running live agents)`
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Local models (P09/P10) — HuggingFace cache copied from D:\Code\agent\models
# Vietnamese_Embedding (1024 dims) + ViRanker reranker. Never commit to git.
# EMBEDDING__LOCAL_PATH=models/models--AITeamVN--Vietnamese_Embedding/snapshots/<revision>
# EMBEDDING__DIMENSIONS=1024
# RERANKER__LOCAL_PATH=models/models--namdp-ptit--ViRanker/snapshots/<revision>

# Parsing layer (P9B) — inline OCR fallback stays OFF in runtime V1 (P9E queue)
# PARSING__OCR_FALLBACK_ENABLED=false
# PARSING__MIN_USEFUL_TEXT_LENGTH=64
# PARSING__LARGE_SOURCE_BYTES=200000
# PARSING__GARBAGE_CHAR_RATIO=0.25

# Google OAuth Credentials (P05)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY_FILE=.secrets/google_token.key
