# Application Environment
# DEPLOY_TARGET is independent of ENVIRONMENT: local | staging | production.
# staging/production targets cannot combine with ENVIRONMENT=development.
ENVIRONMENT=development
DEPLOY_TARGET=local
DEBUG=true

# HTTP boundary security
# Shared API key required on every request via X-API-Key.
# Unset outside development/testing fails closed (all authenticated routes reject).
SECURITY__API_KEY=
# User id bound to the shared API key. REQUIRED in staging/production (H3 IDOR).
SECURITY__API_KEY_USER_ID=
# Explicit CORS origin allowlist (never combine '*' with credentials).
SECURITY__CORS_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Dedicated HMAC-SHA256 key for signing approval tokens (≥32 bytes).
# REQUIRED in staging/production (process refuses to start without it).
# Unset in development/testing uses a logged test-only key — never deploy that way.
# NEVER put live provider keys in this file or a committed .env.
# Rotate any key that has appeared in a shared folder, backup, or screen-share.
# Prefer the OS/cloud secret manager (or compose secrets) and inject at runtime.
# Pre-commit: `pre-commit install` runs gitleaks against staged diffs.
# Windows: protect the env file / key file with:
#   icacls .env /inheritance:r /grant:r %USERNAME%:R
SECURITY__APPROVAL_SIGNING_KEY=

# Compose + app database (never commit real secrets; docker compose requires these)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=assistant
POSTGRES_PORT=5434
DATABASE__URL=postgresql+asyncpg://postgres:changeme_local_only@localhost:5434/assistant
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__ECHO=false

# Redis (requirepass in compose; URL must include the password)
REDIS_PASSWORD=changeme_local_only
REDIS__URL=redis://:changeme_local_only@localhost:6379/0
REDIS__SESSION_TTL_SECONDS=86400
REDIS__CACHE_TTL_SECONDS=3600
REDIS__SOCKET_TIMEOUT_SECONDS=2.0

# LangSmith Tracing (Optional)
LANGSMITH__TRACING_ENABLED=false
LANGSMITH__ENDPOINT=https://api.smith.langchain.com
LANGSMITH__API_KEY=
LANGSMITH__PROJECT=personal-ai-assistant

# LLM Providers (Configure when running live agents)
# Inject via secret manager — leave blank in committed files.
# Either flat (OPENAI_API_KEY) or nested (LLM__OPENAI_API_KEY) are supported.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM__OPENAI_API_KEY=
# LLM__ANTHROPIC_API_KEY=
# LLM__GEMINI_API_KEY=

# Local models (P09/P10) — HuggingFace cache copied from D:\Code\agent\models
# Vietnamese_Embedding (1024 dims) + ViRanker reranker. Never commit to git.
# EMBEDDING__LOCAL_PATH=models/models--AITeamVN--Vietnamese_Embedding/snapshots/<revision>
# EMBEDDING__DIMENSIONS=1024
# RERANKER__LOCAL_PATH=models/models--namdp-ptit--ViRanker/snapshots/<revision>

# Parsing layer (P9B) — inline OCR fallback stays OFF in runtime V1 (P9E queue)
# PARSING__OCR_FALLBACK_ENABLED=false
# PARSING__MIN_USEFUL_TEXT_LENGTH=64
# PARSING__LARGE_SOURCE_BYTES=200000
# PARSING__GARBAGE_CHAR_RATIO=0.25

# Google OAuth Credentials (P05) — never commit live client secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_SECRETS_FILE=client_secret.json
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Base64 32-byte Fernet key string (takes priority over key file when supplied)
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Key file used when GOOGLE_TOKEN_ENCRYPTION_KEY is unset (auto-created in dev/test only)
GOOGLE_TOKEN_ENCRYPTION_KEY_FILE=.secrets/google_token.key
